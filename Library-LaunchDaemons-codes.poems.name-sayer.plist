<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>codes.poems.name-sayer</string>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
		<string>Background</string>
		<string>LoginWindow</string>
		<string>System</string>
	</array>
	<key>ProgramArguments</key>
	<array>
		<!-- <string>/opt/homebrew/opt/name-sayer/sbin/name-sayer</string> -->
		<string>/usr/local/bin/name-sayer</string>

		<string>--blocklist-files</string>
		<string>/opt/name-sayer/blocklist.txt</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
        <key>StandardOutPath</key>
	<string>/var/log/name-sayer.stdout.log</string>
        <key>StandardErrorPath</key>
	<string>/var/log/name-sayer.stderr.log</string>
        <key>Debug</key>
        <true/>
        <key>ProcessType</key>
        <string>Background</string>

</dict>
</plist>
